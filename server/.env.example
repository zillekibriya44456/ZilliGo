# ZillGO Server Configuration
PORT=5001
JWT_SECRET=your_super_secret_jwt_key
DATABASE_URL=postgres://user:password@localhost:5432/zillgo
FRONTEND_URL=http://localhost:5173

# Frontend builds need this set in Vercel/Netlify when the API is hosted elsewhere.
# Example: VITE_API_URL=https://your-render-api.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...

# REAL OAUTH CONFIGURATION
# Provide your Client IDs from developer consoles to make social login work

# Google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://zilli-go.vercel.app/api/auth/google/callback

# GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_REDIRECT_URI=http://localhost:5001/api/auth/github/callback

# Facebook
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_REDIRECT_URI=http://localhost:5001/api/auth/facebook/callback

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/auth/linkedin/callback

# Instagram
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_REDIRECT_URI=http://localhost:5001/api/auth/instagram/callback
